# ===== 演示项目基础配置 =====
# 全部数据来自本地 mock，不含任何真实服务地址

# 只在开发模式中被载入
VITE_PORT=5180

# 应用名称
VITE_APP_TITLE=一体化管理系统

# 应用标识
VITE_APP_SHORT_NAME=atlas

# 网站根目录
VITE_PUBLIC_PATH=/

# 上传地址（本地占位，不做真实上传）
VITE_UPLOAD_URL=/

# 文件前缀地址
VITE_FILE_URL=

# 本地 mock 请求命名空间（仅用于区分，不指向任何真实服务）
VITE_API_URL=
VITE_API_URL_PREFIX=/mock-api

# 本地 mock 授权命名空间
VITE_API_AUTH_PREFIX=atlas

# 消息分类
VITE_API_MESSAGE_KIND=DEMO

# 是否启用本地 mock（演示项目始终为 true）
VITE_USE_MOCK=true

# 是否打印 mock 请求日志
VITE_LOGGER_MOCK=false

# 独立文件预览服务地址（留空则使用内置预览页，仅开发模式有效）
VITE_FILE_PREVIEW_BASE=

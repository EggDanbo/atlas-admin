{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleDetection": "force",
    "libReplacement": false,
    "module": "ESNext",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "typeRoots": [
      "./node_modules/@types/",
      "./typings/"
    ],
    "types": ["node"],
    "allowImportingTsExtensions": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": false,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "package.json",
    "build/vite/**/*.ts",
    "vite.config.ts",
    "typings/**/*.d.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "build/script/buildReporter.ts"
  ]
}

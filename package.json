{
  "name": "atlas-admin",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas Admin · 一体化管理系统，纯前端演示版（本地 mock 数据）",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "serve": "pnpm run dev",
    "dev": "vite",
    "host": "cross-env NODE_ENV=host vite --mode host",
    "build": "cross-env NODE_ENV=production vite build",
    "build:test": "cross-env vite build --mode test",
    "report": "cross-env REPORT=true pnpm run build",
    "preview": "pnpm run build && vite preview",
    "preview:dist": "vite preview",
    "lint": "eslint --cache --cache-location=node_modules/.cache/.eslint-cache -f compact",
    "lint:fix": "pnpm run lint --fix",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:lib": "rimraf node_modules",
    "reinstall": "rimraf pnpm-lock.json && rimraf package.lock.json && rimraf node_modules && npm run bootstrap",
    "prepare": "simple-git-hooks",
    "tsc:app": "npx tsc --noEmit -p tsconfig.app.json",
    "tsc:node": "npx tsc --noEmit -p tsconfig.node.json",
    "icons:scan": "tsx scripts/scan-icons.ts",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "icons:all": "tsx scripts/scan-icons.ts && tsx scripts/generate-icons.ts",
    "icons:check": "tsx scripts/scan-icons.ts --check",
    "mock:schema": "node scripts/mock/extract-schema.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:run"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@file-viewer/preset-office": "^3.0.0",
    "@file-viewer/renderer-text": "^3.0.0",
    "@file-viewer/vue3": "^3.0.0",
    "@iconify/vue": "^5.0.1",
    "@microsoft/signalr": "^10.0.11",
    "@turf/turf": "^7.4.0",
    "@unocss/reset": "^66.8.1",
    "@videojs-player/vue": "^1.0.0",
    "@vue-cmd/core": "^1.2.3",
    "@vue-cmd/naive": "^1.0.8",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "@vxe-ui/plugin-export-xlsx": "^4.5.4",
    "@wecom/jssdk": "^2.4.2",
    "alova": "^3.5.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-resize-detector": "^1.2.4",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.12.0",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "naive-ui": "^2.45.3",
    "ol": "^10.10.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pinyin-pro": "^3.29.3",
    "print-js": "^1.6.0",
    "pro-naive-ui": "^3.2.3",
    "tinycolor2": "^1.6.0",
    "video.js": "^8.24.0",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.10",
    "vue-prism-editor": "2.0.0-alpha.2",
    "vue-router": "^5.3.0",
    "vue-types": "^7.0.0",
    "vxe-pc-ui": "^4.17.23",
    "vxe-table": "^4.21.3",
    "xe-utils": "^4.0.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@file-viewer/assets-standard": "^3.0.0",
    "@file-viewer/vite-plugin": "^3.0.0",
    "@iconify/json": "^2.2.522",
    "@iconify/utils": "^3.1.4",
    "@types/element-resize-detector": "^1.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.0",
    "@types/nprogress": "^0.2.3",
    "@types/tinycolor2": "^1.4.6",
    "@unocss/eslint-config": "^66.8.1",
    "@unocss/eslint-plugin": "^66.8.1",
    "@unocss/preset-wind3": "^66.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "baseline-browser-mapping": "^2.11.20",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-format": "^2.0.1",
    "fast-glob": "^3.3.3",
    "less": "^4.9.0",
    "lint-staged": "^17.4.1",
    "picocolors": "^1.1.1",
    "pro-naive-ui-resolver": "^1.0.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.103.1",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "type-fest": "^5.8.0",
    "typescript": "~6.0.3",
    "unocss": "^66.8.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-lazy-import": "^1.0.7",
    "vite-plugin-router-warn": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
